def fazer_solicitacao(solicitacoes, usuarios, usuario_logado):  # recebe a lista, os usuários e o email de quem logou
    local = usuarios[usuario_logado]['curso']['curso']  # entra no usuário, depois no dicionário do curso, e pega o nome do curso
    print(f'Local da solicitação: {local}')  # mostra o local, que é o curso do aluno
    descricao = input('Descreva o problema: ').strip()
    if not descricao:
        print('A descrição não pode ficar vazia.')
        return  # o usuário digita o problema e a variável guarda o texto

    solicitacao = {'autor': usuario_logado, 'local': local, 'descricao': descricao, 'status': 'Andamento', 'votos': {'Alta': 0, 'Media': 0, 'Baixa': 0},
    'votantes': []}  # dicionário pequeno com as 3 informações
    solicitacoes.append(solicitacao)  # coloca o dicionário no final da lista
    print('Solicitação registrada!')  # avisa que deu certo


def ver_solicitacoes(solicitacoes):  # recebe só a lista
    if len(solicitacoes) == 0:  # len conta os itens; 0 significa lista vazia
        print('Nenhuma solicitação ainda.')  # trata o caso da lista vazia
    else:
        for s in solicitacoes:  # percorre a lista, e s é um dicionário por vez
            print(f"Autor: {s['autor']} | Local: {s['local']} | Descrição: {s['descricao']} | Status: {s.get('status', 'Andamento')} | Prioridade: {calcular_prioridade(s)}")  # busca cada valor pela chaves

#Status

def alterar_status(solicitacoes):
    if not solicitacoes:
        print('Nenhuma solicitação registrada.')
        return

    for i, s in enumerate(solicitacoes, start=1):
        print(f"[{i}] {s['descricao']} ({s['local']}) - Status: {s.get('status', 'Andamento')}")

    escolha = input('\nDigite o número da solicitação para alterar o status: ').strip()

    if escolha.isdigit() and 1 <= int(escolha) <= len(solicitacoes):
        s = solicitacoes[int(escolha) - 1]
        print('[1] Andamento | [2] Concluida')
        novo_status = input('Escolha o novo status: ').strip()

        if novo_status == '1':
            s['status'] = 'Andamento'
            print('Status atualizado para Andamento!')
        elif novo_status == '2':
            s['status'] = 'Concluida'
            print('Status atualizado para Concluida!')
        else:
            print('Opção inválida.')
    else:
        print('Número inválido.')

#Enquete de Prioridade(Alta, Média, Baixa, Sem votos)

def calcular_prioridade(solicitacao):
    votos = solicitacao.get('votos', {'Alta': 0, 'Media': 0, 'Baixa': 0})
    total = sum(votos.values())

    if total == 0:
        return "Sem votos"

    vencedora = max(votos, key=votos.get)
    porcentagem = (votos[vencedora] / total) * 100
    return f"{vencedora} ({porcentagem:.0f}%)"


def votar_prioridade(solicitacoes, usuario_logado):
    andamento = [s for s in solicitacoes if s.get('status', 'Andamento') == 'Andamento']

    if not andamento:
        print('Nenhuma solicitação em andamento para votar.')
        return

    for i, s in enumerate(andamento, start=1):
        print(f"[{i}] {s['descricao']} ({s['local']}) - Prioridade: {calcular_prioridade(s)}")

    escolha = input('\nEscolha o número da solicitação para votar: ').strip()

    if escolha.isdigit() and 1 <= int(escolha) <= len(andamento):
        s = andamento[int(escolha) - 1]

        s.setdefault('votos', {'Alta': 0, 'Media': 0, 'Baixa': 0})
        s.setdefault('votantes', [])

        if usuario_logado in s['votantes']:
            print('Você já votou na prioridade desta solicitação!')
            return

        print('[1] Alta | [2] Média | [3] Baixa')
        voto = input('Qual o nível de prioridade? ').strip()

        opcoes = {'1': 'Alta', '2': 'Media', '3': 'Baixa'}
        if voto in opcoes:
            nivel = opcoes[voto]
            s['votos'][nivel] += 1
            s['votantes'].append(usuario_logado)
            print(f'Voto "{nivel}" registrado! Prioridade atual: {calcular_prioridade(s)}')
        else:
            print('Opção inválida.')
    else:
        print('Número inválido.')
