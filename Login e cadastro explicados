def enviar_codigo(destinatario, codigo): # def vai definir uma função chamada enviar_codigo que recebe dois parâmetros: destinatario e codigo. Essa função vai enviar um email com o código de verificação para o destinatário especificado.
    remetente = os.environ["EMAIL_REMETENTE"] # o remetente é o email que vai enviar o código de verificação. Ele é obtido a partir de uma variável de ambiente chamada EMAIL_REMETENTE, que deve ser definida no sistema operacional antes de executar o programa.
    senha_app = os.environ["EMAIL_SENHA_APP"] # o os.environ vai acessar a variável de ambiente EMAIL_SENHA_APP, que deve conter a senha do aplicativo de email do remetente. Essa senha é necessária para autenticar o remetente no servidor de email e enviar o código de verificação.
    msg = EmailMessage() # EmailMessage vai criar um objeto de mensagem de email que vai ser usado para enviar o código de verificação. O objeto msg vai armazenar as informações do email, como remetente, destinatário, assunto e conteúdo.
    msg['From'] = remetente
    msg['To'] = destinatario
    msg['Subject'] = "Código de verificação"
    msg.set_content(f"Seu código de verificação é: {codigo}")
    with smtplib.SMTP_SSL('smtp.gmail.com', 465) as servidor:
        servidor.login(remetente, senha_app)
        servidor.send_message(msg) 
def senha_valida(senha): # def vai definir uma função chamada senha_valida que recebe um parâmetro chamado senha. Essa função vai verificar se a senha atende aos critérios de segurança estabelecidos.
    qnt_caracteres = len(senha)  #len vai contar a quantidade de caracteres da senha e armazenar na variável qnt_caracteres.


    tem_maiuscula = False # se a senha tiver pelo menos uma letra maiúscula, essa variável vai ser True, caso contrário, vai ser False.
    tem_minuscula = False # se a senha tiver pelo menos uma letra minúscula, essa variável vai ser True, caso contrário, vai ser False.
    tem_numero = False # se a senha tiver pelo menos um número, essa variável vai ser True, caso contrário, vai ser False.

    for caractere in senha: # vai percorrer cada caractere da senha e verificar se ele é uma letra maiúscula, uma letra minúscula ou um número. Se for, a variável correspondente vai ser atualizada para True.
        if caractere.isupper(): #if vai verificar se o caractere é uma letra maiúscula. Se for, a variável tem_maiuscula vai ser atualizada para True.
            tem_maiuscula = True
        if caractere.isdigit(): #if vai verificar se o caractere é um número. Se for, a variável tem_numero vai ser atualizada para True.
            tem_numero = True
        if caractere.islower(): #if vai verificar se o caractere é uma letra minúscula. Se for, a variável tem_minuscula vai ser atualizada para True.
            tem_minuscula = True
    if tem_maiuscula and tem_minuscula and tem_numero:
        if 8 <= qnt_caracteres <= 20: # se a senha tiver pelo menos uma letra maiúscula, uma letra minúscula e um número, e se a quantidade de caracteres estiver entre 8 e 20, a função vai retornar True, indicando que a senha é válida. Caso contrário, vai retornar False.
            return True # return True vai indicar que a senha é válida.
        return False # return False vai indicar que a senha não é válida.
